# Google Antigravity Academy & Mission Control - Environment Example
# In AI Studio, GEMINI_API_KEY and APP_URL are automatically injected at runtime.

# Server & Runtime Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Client Configuration
VITE_APP_NAME="Google Antigravity Academy & Mission Control"
VITE_APP_DEFAULT_LANG=fa
VITE_APP_THEME=dark

# Optional: Server-side API key for Gemini models
GEMINI_API_KEY="MY_GEMINI_API_KEY"
